# ResolveX Environment Configuration
PROJECT_NAME="Enterprise Customer Experience Intelligence & Autonomous Dispute Resolution (ResolveX)"
AI_ENGINE_NAME="LexIntel AI"
SECRET_KEY="resolvex-production-secret-replace-with-secure-random-token"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL (SQLite for zero-configuration, or PostgreSQL: postgresql://postgres:postgres@localhost:5432/resolvex)
DATABASE_URL="sqlite:///./resolvex.db"

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# ML Thresholds
CHURN_LOW_THRESHOLD=0.40
CHURN_HIGH_THRESHOLD=0.70

# Optional External AI Provider ("rule_based", "openai", "gemini")
LLM_PROVIDER="rule_based"
LLM_API_KEY=""
